From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martijn Muijsers <martijnmuijsers@live.nl>
Date: Fri, 25 Nov 2022 13:18:54 +0100
Subject: [PATCH] Do not log ignored advancements

Ported from Winds-Studio/Leaf ver/26.2 (0029-Do-not-log-ignored-advancements.patch), GPL-3.0-only.
Original author: Martijn Muijsers.
Canvas adaptation: config gate mapped to logs.ignoredAdvancements (upstream Gale logToConsole.ignoredAdvancements).

diff --git a/net/minecraft/server/PlayerAdvancements.java b/net/minecraft/server/PlayerAdvancements.java
index aac9dbb9803d472617b094c40033dde328eddb32..6ad4ad87991c90f51cff8cccd74690cfa2cb8a67 100644
--- a/net/minecraft/server/PlayerAdvancements.java
+++ b/net/minecraft/server/PlayerAdvancements.java
@@ -146,7 +146,7 @@ public class PlayerAdvancements {
             AdvancementHolder advancement = manager.get(id);
             if (advancement == null) {
                 if (!id.getNamespace().equals(Identifier.DEFAULT_NAMESPACE)) return; // CraftBukkit
-                LOGGER.warn("Ignored advancement '{}' in progress file {} - it doesn't exist anymore?", id, this.playerSavePath);
+                if (io.canvasmc.canvas.GlobalConfiguration.getInstance().logs.ignoredAdvancements) LOGGER.warn("Ignored advancement '{}' in progress file {} - it doesn't exist anymore?", id, this.playerSavePath); // Canvas - Purpur - do not log ignored advancements
             } else {
                 this.startProgress(advancement, progress);
                 this.progressChanged.add(advancement);
