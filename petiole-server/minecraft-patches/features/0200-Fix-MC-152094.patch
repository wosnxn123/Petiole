+    private static final ThreadLocal<@org.jspecify.annotations.Nullable ReferenceBounds> REFERENCE_BOUNDS = new ThreadLocal<>(); // Canvas - Fix MC-152094
+
+    private static void addShipWithinReferenceBounds( // Canvas start - Fix MC-152094
+        final StructureTemplateManager structureTemplateManager,
+        final EndCityPieces.EndCityPiece parent,
+        final int localX,
+        final int localY,
+        final int requestedLocalZ,
+        final Rotation rotation,
+        final List<StructurePiece> pieces,
+        final @org.jspecify.annotations.Nullable ReferenceBounds referenceBounds
+    ) {
+        java.util.Objects.requireNonNull(referenceBounds); // Throw NPE if related vanilla logic changes in future Minecraft versions
+
+        for (int localZ = requestedLocalZ; localZ <= 0; localZ++) {
+            EndCityPieces.EndCityPiece ship = EndCityPieces.addPiece(
+                structureTemplateManager,
+                parent,
+                new BlockPos(localX, localY, localZ),
+                "ship",
+                rotation,
+                true
+            );
+
+            if (
+                referenceBounds.contains(ship.getBoundingBox())
+                    && StructurePiece.findCollisionPiece(pieces, ship.getBoundingBox()) == null
+            ) {
+                EndCityPieces.addHelper(pieces, ship);
+                return;
+            }
+        }
+        LOGGER.warn("Unable to find a valid ship position, end ship will continue to generate anyway.");
+        EndCityPieces.addPiece(
+            structureTemplateManager,
+            parent,
+            new BlockPos(localX, localY, requestedLocalZ),
+            "ship",
+            rotation,
+            true
+        );
+    }
+
+    private record ReferenceBounds(int minX, int maxX, int minZ, int maxZ) {
+
+        private static ReferenceBounds around(final BlockPos startPos) {
+            int startChunkX = net.minecraft.core.SectionPos.blockToSectionCoord(startPos.getX());
+            int startChunkZ = net.minecraft.core.SectionPos.blockToSectionCoord(startPos.getZ());
+            int radius = 8; // ChunkStatus#MAX_STRUCTURE_DISTANCE
+
+            return new ReferenceBounds(
+                net.minecraft.core.SectionPos.sectionToBlockCoord(startChunkX - radius),
+                net.minecraft.core.SectionPos.sectionToBlockCoord(startChunkX + radius, 15),
+                net.minecraft.core.SectionPos.sectionToBlockCoord(startChunkZ - radius),
+                net.minecraft.core.SectionPos.sectionToBlockCoord(startChunkZ + radius, 15)
+            );
+        }
+
+        private boolean contains(final BoundingBox box) {
+            return box.minX() >= this.minX
+                && box.maxX() <= this.maxX
+                && box.minZ() >= this.minZ
+                && box.maxZ() <= this.maxZ;
+        }
+    }
+
+    private static final org.slf4j.Logger LOGGER = com.mojang.logging.LogUtils.getLogger(); // Canvas - Fix MC-152094
+
     private static boolean recursiveChildren(
         final StructureTemplateManager structureTemplateManager,
         final EndCityPieces.SectionGenerator generator,
