From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martijn Muijsers <martijnmuijsers@live.nl>
Date: Fri, 25 Nov 2022 15:07:55 +0100
Subject: [PATCH] Do not log expired message warnings

Ported from Winds-Studio/Leaf ver/26.2 (0032-Do-not-log-expired-message-warnings.patch), GPL-3.0-only.
Original author: Martijn Muijsers.
Canvas adaptation: config gate mapped to logs.expiredMessageWarning.

diff --git a/net/minecraft/network/chat/PlayerChatMessage.java b/net/minecraft/network/chat/PlayerChatMessage.java
index 3a9d3097a836bd7acce8b60d32c9d9aea12de1fc..3a429871252125abda5572efda0e249c6568e3a0 100644
--- a/net/minecraft/network/chat/PlayerChatMessage.java
+++ b/net/minecraft/network/chat/PlayerChatMessage.java
@@ -143,7 +143,7 @@ public record PlayerChatMessage(
     }
 
     public boolean hasExpiredServer(final Instant now) {
-        return now.isAfter(this.timeStamp().plus(MESSAGE_EXPIRES_AFTER_SERVER));
+        return now.isAfter(this.timeStamp().plus(MESSAGE_EXPIRES_AFTER_SERVER)); // Canvas - do not log expired message warnings - diff on change
     }
 
     public boolean hasExpiredClient(final Instant now) {
diff --git a/net/minecraft/network/chat/SignedMessageChain.java b/net/minecraft/network/chat/SignedMessageChain.java
index c7bef2318a68caae0be5d57dfcdc53927849a805..76f3c6cf24baedbaa4bb38ea9348ed19b46c2271 100644
--- a/net/minecraft/network/chat/SignedMessageChain.java
+++ b/net/minecraft/network/chat/SignedMessageChain.java
@@ -61,7 +61,7 @@ public class SignedMessageChain {
                     throw new SignedMessageChain.DecodeException(SignedMessageChain.DecodeException.INVALID_SIGNATURE);
                 }
 
-                if (unpacked.hasExpiredServer(Instant.now())) {
+                if (io.canvasmc.canvas.GlobalConfiguration.getInstance().logs.expiredMessageWarning && unpacked.hasExpiredServer(Instant.now())) { // Canvas - do not log expired message warnings
                     SignedMessageChain.LOGGER.warn("Received expired chat: '{}'. Is the client/server system time unsynchronized?", body.content());
                 }
 
