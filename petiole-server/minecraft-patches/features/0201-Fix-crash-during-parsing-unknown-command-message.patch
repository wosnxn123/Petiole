From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dreeam <61569423+Dreeam-qwq@users.noreply.github.com>
Date: Sun, 15 Jun 2025 02:20:26 +0800
Subject: [PATCH] Fix crash during parsing unknown command message

Ported from Winds-Studio/Leaf ver/26.2 (0232-Fix-crash-during-parsing-unknown-command-message.patch), GPL-3.0-only.
Original author: Dreeam.
Canvas adaptation: Upstream Leaves touches two helper methods (getVanillaUnknownCommandMessage/detailComponent); Canvas baseline has a single finishParsing catch block - both fixes applied there. Message deserialization routed through ComponentUtils.fromMessage + PaperAdventure.asAdventure and context substrings wrapped with StringUtil.filterText.

diff --git a/net/minecraft/commands/Commands.java b/net/minecraft/commands/Commands.java
index 19774a47830260d21751bc66eb1ac9bd551f61a7..9d69e2c8baf3f8a5acae68bc41b5007582e0dbc8 100644
--- a/net/minecraft/commands/Commands.java
+++ b/net/minecraft/commands/Commands.java
@@ -416,7 +416,7 @@ public class Commands {
             // Paper start - Add UnknownCommandEvent
             final net.kyori.adventure.text.TextComponent.Builder builder = net.kyori.adventure.text.Component.text();
             // sender.sendFailure(ComponentUtils.fromMessage(var7.getRawMessage()));
-            builder.color(net.kyori.adventure.text.format.NamedTextColor.RED).append(io.papermc.paper.command.brigadier.MessageComponentSerializer.message().deserialize(e.getRawMessage()));
+            builder.color(net.kyori.adventure.text.format.NamedTextColor.RED).append(io.papermc.paper.adventure.PaperAdventure.asAdventure(ComponentUtils.fromMessage(e.getRawMessage()))); // Canvas - Fix crash during parsing unknown command message
             // Paper end - Add UnknownCommandEvent
             if (e.getInput() != null && e.getCursor() >= 0) {
                 int cursor = Math.min(e.getInput().length(), e.getCursor());
@@ -427,9 +427,9 @@ public class Commands {
                     context.append(CommonComponents.ELLIPSIS);
                 }
 
-                context.append(e.getInput().substring(Math.max(0, cursor - 10), cursor));
+                context.append(net.minecraft.util.StringUtil.filterText(e.getInput().substring(Math.max(0, cursor - 10), cursor))); // Canvas - Filter out disallowed control chars
                 if (cursor < e.getInput().length()) {
-                    Component remaining = Component.literal(e.getInput().substring(cursor)).withStyle(ChatFormatting.RED, ChatFormatting.UNDERLINE);
+                    Component remaining = Component.literal(net.minecraft.util.StringUtil.filterText(e.getInput().substring(cursor))).withStyle(ChatFormatting.RED, ChatFormatting.UNDERLINE); // Canvas - Filter out disallowed control chars
                     context.append(remaining);
                 }
 
