From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martijn Muijsers <martijnmuijsers@live.nl>
Date: Sat, 29 Jul 2023 11:20:35 +0200
Subject: [PATCH] Do not log disconnections with null id

Ported from Winds-Studio/Leaf ver/26.2 (0034-Do-not-log-disconnections-with-null-id.patch), GPL-3.0-only.
Original author: Martijn Muijsers.
Canvas adaptation: config gate mapped to logs.nullIdDisconnections.

diff --git a/net/minecraft/server/network/ServerLoginPacketListenerImpl.java b/net/minecraft/server/network/ServerLoginPacketListenerImpl.java
index d7372d5139f7263806f568790174572d184966e2..c253c4cf9b4f3a5f6f8d3218ac47f96cbce0e07c 100644
--- a/net/minecraft/server/network/ServerLoginPacketListenerImpl.java
+++ b/net/minecraft/server/network/ServerLoginPacketListenerImpl.java
@@ -141,6 +141,14 @@ public class ServerLoginPacketListenerImpl implements ServerLoginPacketListener,
     // Paper end
     public void disconnect(final Component component) {
         try {
+            // Canvas start - Pufferfish - do not log disconnections with null id
+            if (!io.canvasmc.canvas.GlobalConfiguration.getInstance().logs.nullIdDisconnections && this.authenticatedProfile != null && this.authenticatedProfile.id() == null) {
+                String reasonString = component.getString();
+                if ("Disconnected".equals(reasonString) || Component.translatable("multiplayer.disconnect.generic").getString().equals(reasonString)) {
+                    return;
+                }
+            }
+            // Canvas end - Pufferfish - do not log disconnections with null id
             LOGGER.info("Disconnecting {}: {}", this.getUserName(), component.getString());
             this.connection.send(new ClientboundLoginDisconnectPacket(component));
             this.connection.disconnect(component);
