From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: HaHaWTH <102713261+HaHaWTH@users.noreply.github.com>
Date: Tue, 9 Nov 2077 00:00:00 +0800
Subject: [PATCH] Fix MC-270656

Ported from Winds-Studio/Leaf ver/26.2 (0151-Fix-MC-270656.patch), GPL-3.0-only.
Original author: HaHaWTH.
Canvas adaptation: Leaf config gate removed - fix applied unconditionally; config key mc270656 reported for mainline wiring. Field reference currentImpulseImpactPos adapted to Canvas baseline name currentExplosionImpactPos.

diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
index 683c2f35001a34b910d655252c219232f9763c74..047e9a3337a584d584e938fb09032be8349c0790 100644
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -1284,6 +1284,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     }
 
     public void trackStartFallingPosition() {
+        this.resetImpulseImpactIfNeeded(false); // Canvas - Fix MC-270656
         if (this.fallDistance > 0.0 && this.startingToFallPosition == null) {
             this.startingToFallPosition = this.position();
             if (this.currentExplosionImpactPos != null && this.currentExplosionImpactPos.y <= this.startingToFallPosition.y) {
@@ -1295,6 +1296,22 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
         }
     }
 
+    // Canvas start - Fix MC-270656
+    private void resetImpulseImpactIfNeeded(final boolean force) {
+        if (this.currentExplosionImpactPos == null) return;
+        if (this.currentExplosionCause == null || this.currentExplosionCause.getType() != EntityTypes.WIND_CHARGE) return;
+
+        if (force || this.getAbilities().flying
+            || this.isFallFlying()
+            || this.onClimbable()
+            || this.isPassenger()
+            || this.hasEffect(MobEffects.LEVITATION)) {
+            this.currentExplosionImpactPos = null;
+            this.currentExplosionCause = null;
+        }
+    }
+    // Canvas end - Fix MC-270656
+
     public void trackEnteredOrExitedLavaOnVehicle() {
         if (this.getVehicle() != null && this.getVehicle().isInLava()) {
             if (this.enteredLavaOnVehiclePosition == null) {
@@ -2255,6 +2272,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
             this.connection.internalTeleport(PositionMoveRotation.of(transition), transition.relatives()); // CraftBukkit  
             this.connection.resetPosition();
             transition.postTeleportTransition().onTransition(this);
+            this.resetImpulseImpactIfNeeded(true); // Canvas - Fix MC-270656
             return this;
         }
 
@@ -2295,6 +2313,7 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
             this.stopUsingItem();
         }
         // Paper end - Reset shield blocking on dimension change
+        this.resetImpulseImpactIfNeeded(true); // Canvas - Fix MC-270656
         return this;
     }
 
