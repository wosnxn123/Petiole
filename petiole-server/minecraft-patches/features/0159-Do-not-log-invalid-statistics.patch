From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Martijn Muijsers <martijnmuijsers@live.nl>
Date: Thu, 24 Nov 2022 23:39:32 +0100
Subject: [PATCH] Do not log invalid statistics

Ported from Winds-Studio/Leaf ver/26.2 (0027-Do-not-log-invalid-statistics.patch), GPL-3.0-only.
Original author: Martijn Muijsers.
Canvas adaptation: config gate mapped to logs.invalidStatistics (upstream Gale logToConsole.invalidStatistics).

diff --git a/net/minecraft/stats/ServerStatsCounter.java b/net/minecraft/stats/ServerStatsCounter.java
index f5beb001b938072e78c0ead7e0ad0499784ed1cf..c6655421f6377b36cc3e47e2867afaccb53c71ae 100644
--- a/net/minecraft/stats/ServerStatsCounter.java
+++ b/net/minecraft/stats/ServerStatsCounter.java
@@ -121,7 +121,7 @@ public class ServerStatsCounter extends StatsCounter {
         this.stats
             .putAll(
                 STATS_CODEC.parse(data.get("stats").orElseEmptyMap())
-                    .resultOrPartial(error -> LOGGER.error("Failed to parse statistics for {}: {}", this.file, error))
+                    .resultOrPartial(error -> {if (io.canvasmc.canvas.GlobalConfiguration.getInstance().logs.invalidStatistics) LOGGER.error("Failed to parse statistics for {}: {}", this.file, error);}) // Canvas - EMC - do not log invalid statistics
                     .orElse(Map.of())
             );
     }
