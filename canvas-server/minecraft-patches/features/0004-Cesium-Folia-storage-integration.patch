+    protected final void initializePersistentStorage(final boolean configureCesium) {
+        if (this.randomSequences != null) {
+            throw new IllegalStateException("Persistent storage is already initialized");
+        }
+        if (configureCesium) {
+            final Path worldRoot = this.storageSource.getLevelPath(LevelResource.ROOT);
+            final boolean existingWorld = Files.isRegularFile(this.storageSource.getLevelPath(LevelResource.LEVEL_DATA_FILE));
+            io.canvasmc.canvas.storage.cesium.CesiumStorageManager.open(worldRoot, existingWorld);
+        }
+        this.randomSequences = this.savedDataStorage.computeIfAbsent(RandomSequences.TYPE);
+        this.clockManager = this.savedDataStorage.computeIfAbsent(ServerClockManager.TYPE);
+        this.clockManager.init(this);
+        this.customBossEvents = this.savedDataStorage.computeIfAbsent(CustomBossEvents.TYPE);
