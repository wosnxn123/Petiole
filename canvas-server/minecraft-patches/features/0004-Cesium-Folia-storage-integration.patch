+    private static byte[] serializeCesium(final CompoundTag value) throws IOException {
+        final ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+        try (DataOutputStream output = new DataOutputStream(bytes)) {
+            NbtIo.write(value, output);
+        }
+        return bytes.toByteArray();
+    }
+
+    private static CompoundTag deserializeCesium(final byte[] value) throws IOException {
+        try (DataInputStream input = new DataInputStream(new ByteArrayInputStream(value))) {
+            return NbtIo.read(input);
+        }
